<?xml version="1.0" encoding="utf-8"?>
<!-- The expanded notification: the round and what it is for, the time left
     in larger digits, and larger icon buttons under it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <TextView
        android:id="@+id/reef_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:textAppearance="@android:style/TextAppearance.Material.Notification.Title" />

    <TextView
        android:id="@+id/reef_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:singleLine="true"
        android:textAppearance="@android:style/TextAppearance.Material.Notification" />

    <Chronometer
        android:id="@+id/reef_clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="sans-serif-light"
        android:fontFeatureSettings="tnum"
        android:includeFontPadding="false"
        android:textAppearance="@android:style/TextAppearance.Material.Notification.Title"
        android:textSize="56sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/reef_toggle"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="12dp"
            android:scaleType="fitCenter" />

        <ImageButton
            android:id="@+id/reef_end"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="24dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="13dp"
            android:scaleType="fitCenter"
            android:src="@drawable/reef_stop" />
    </LinearLayout>
</LinearLayout>
